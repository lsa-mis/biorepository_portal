<% content_for :head do %>
  <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
        integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
<% end %>

<div class="container-fluid">
  <h1>Items Map</h1>
  <div data-controller="items-map"
       data-items-map-url-value="<%= map_items_path(format: :json) %>"
       style="height: 600px;"
       role="region" aria-label="Map of item collection locations"></div>
</div>